# Read by scripts/buildPackage.cjs, which inlines every variable in this file
# into the built @excalidraw/excalidraw package. NoteCanvas ships only that
# library, so the excalidraw.com app settings upstream keeps here (Firebase
# config, collab/AI/JSON backends, Excalidraw+ keys) were removed: the library
# never reads them, and they leaked excalidraw.com's project config into the
# NoteCanvas bundle.
MODE="production"

VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries

VITE_APP_ENABLE_TRACKING=false

# Set explicitly to false in production mode since vite loads and merges .env.local vars
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
