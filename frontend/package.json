{
  "name": "frontend",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:engine && node scripts/copy-excalidraw-assets.mjs --public && vite --port 6767",
    "build": "npm run build:engine && tsc -b && vite build && node scripts/copy-excalidraw-assets.mjs --dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:max-lines": "node ../scripts/check-source-line-count.cjs",
    "build:engine": "npm run clean:engine && npm run build:esm -w @excalidraw/common && npm run build:esm -w @excalidraw/math && npm run build:esm -w @excalidraw/element && npm run build:esm -w @excalidraw/excalidraw",
    "clean:engine": "rimraf --glob \"excalidraw-engine/packages/*/dist\""
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@types/lodash": "^4.17.25",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jotai": "^2.11.0",
    "jszip": "^3.10.2",
    "lodash": "^4.18.1",
    "lucide-react": "^0.554.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "0.28.2",
    "esbuild-sass-plugin": "3.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16",
      "@mermaid-js/parser": "1.2.1"
    },
    "lodash-es": "4.18.1",
    "mermaid": "10.9.8",
    "dompurify": "^3.4.16",
    "katex": "^0.18.2",
    "uuid": "^11.1.1",
    "postcss-selector-parser": "^7.1.6"
  },
  "workspaces": [
    "excalidraw-engine/packages/*"
  ]
}
