{
  "name": "frontend",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:engine && node scripts/copy-excalidraw-assets.mjs --public && vite --port 6767",
    "build": "npm run build:engine && tsc -b && vite build && node scripts/copy-excalidraw-assets.mjs --dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:max-lines": "node ../scripts/check-source-line-count.cjs",
    "build:engine": "npm run clean:engine && npm run build:esm -w @excalidraw/common && npm run build:esm -w @excalidraw/math && npm run build:esm -w @excalidraw/element && npm run build:esm -w @excalidraw/excalidraw",
    "clean:engine": "rimraf --glob \"excalidraw-engine/packages/*/dist\""
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@types/lodash": "^4.17.20",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jotai": "^2.11.0",
    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "lucide-react": "^0.554.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^27.0.0",
    "@types/lodash.throttle": "^4.1.7",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.18",
    "esbuild": "0.19.10",
    "esbuild-sass-plugin": "2.16.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.10",
    "rimraf": "^5.0.0",
    "sass": "^1.104.0",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16",
      "@mermaid-js/parser": "1.2.1"
    },
    "lodash-es": "4.18.1"
  },
  "workspaces": [
    "excalidraw-engine/packages/*"
  ]
}
