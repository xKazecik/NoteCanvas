events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Preserve upstream TLS context (if present) when proxying to backend.
    # Falls back to current scheme when no forwarded proto is provided.
    map $http_x_forwarded_proto $forwarded_proto {
        default $scheme;
        ~*^https(?:,|$) https;
        ~*^http(?:,|$) http;
    }

    # Only real WebSocket upgrades reach the backend. Forwarding any client
    # Upgrade header (e.g. h2c) would allow request smuggling past nginx.
    map $http_upgrade $ws_upgrade {
        default "";
        ~*^websocket$ websocket;
    }
    map $ws_upgrade $ws_connection {
        default "";
        websocket upgrade;
    }

    # Locations below add their own Cache-Control. By default nginx would then
    # drop the server-level security headers there -- including on index.html,
    # the page every route serves. "merge" keeps them (nginx 1.29.3+).
    add_header_inherit merge;

    sendfile on;
    keepalive_timeout 65;
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Set maximum request body size to 50MB to handle large drawings with embedded images
    client_max_body_size 50M;

    server {
        listen 80;
        server_name localhost;
        root /usr/share/nginx/html;
        index index.html;

        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https: http:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https: ws: wss:;" always;

        # API proxy to backend
        # BACKEND_URL is substituted at container startup (default: backend:8000)
        location /api/ {
            proxy_pass http://__BACKEND_URL__/;
            proxy_http_version 1.1;
            # The backend only uses Host as a label in a user's own export manifest
            # and checks origins against FRONTEND_URL.
            proxy_set_header Host $host; # nosemgrep
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            
            # Buffer and timeout settings for large payloads
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 8 4k;
            proxy_busy_buffers_size 8k;
            client_body_buffer_size 128k;
            
            # Timeouts for large uploads (300 seconds)
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        # WebSocket proxy for Socket.IO
        location /socket.io/ {
            proxy_pass http://__BACKEND_URL__/socket.io/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $ws_upgrade;
            proxy_set_header Connection $ws_connection;
            proxy_set_header Host $host; # nosemgrep
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            
            # Longer timeouts for WebSocket connections
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # Frontend routes
        location / {
            try_files $uri $uri/ /index.html;
        }

        # Never cache the HTML shell. Vite builds use hashed asset filenames, so caching
        # index.html is the primary way users end up stuck on an old UI after upgrades.
        location = /index.html {
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
            expires -1;
            try_files /index.html =404;
        }

        # Runtime config, rewritten by the entrypoint on every container start.
        # It has no content hash, so the asset rule below would pin it for a year
        # and a changed key would never reach the browser. An exact-match
        # location beats that regex regardless of order.
        location = /env.js {
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
            expires -1;
            try_files /env.js =404;
        }

        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }
}
