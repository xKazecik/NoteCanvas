{
  "name": "backend",
  "version": "0.6.0",
  "description": "",
  "scripts": {
    "build": "npm run prisma:generate && tsc",
    "predev": "node scripts/predev-migrate.cjs",
    "dev": "node --watch --require ts-node/register src/index.ts",
    "start": "node dist/index.js",
    "admin:recover": "node scripts/admin-recover.cjs",
    "dev:simulate-auth-onboarding:fresh": "node scripts/simulate-auth-onboarding.cjs --scenario fresh",
    "dev:simulate-auth-onboarding:migration": "node scripts/simulate-auth-onboarding.cjs --scenario migration",
    "dev:simulate-auth-onboarding:dry-run": "node scripts/simulate-auth-onboarding.cjs --scenario migration --dry-run",
    "oidc:doctor": "node scripts/oidc-doctor.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:max-lines": "node ../scripts/check-source-line-count.cjs",
    "check:env-boundary": "node ../scripts/check-env-boundary.cjs",
    "gen:env": "ts-node src/config/generateEnvReference.ts",
    "prisma:generate": "node scripts/generate-prisma-clients.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsdom": "^30.1.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "ms": "^2.1.3",
    "multer": "^2.4.0",
    "openid-client": "^5.7.1",
    "prisma": "^7.10.0",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
