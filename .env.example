# ---------------------------------------------------------------------------
# notecanvas configuration.
#
#   cp .env.example .env    and edit. Everything here is optional -- the app
#   boots with no .env at all -- but you should set JWT_SECRET and CSRF_SECRET.
#
# Every value below is shown with its built-in default, commented out. Uncomment
# only what you actually want to change. The authoritative list lives in
# backend/src/config/registry/ and is documented in docs/CONFIGURATION.md.
#
# NOTE: the compose files pin NODE_ENV, PORT and BACKEND_URL in their own
# environment block, which wins over this file. No need to set them here.
# ---------------------------------------------------------------------------


# === Compose ===
# Read by docker-compose.yml / docker-compose.build.yml themselves, not by the app.

# Image tag to run (docker-compose.yml).
#NOTECANVAS_TAG=latest

# Version stamped into a source build (docker-compose.build.yml). Leave it as
# "local" to keep the update prompt quiet for builds that aren't a release.
#NOTECANVAS_VERSION=local

# Host port the app is published on (the container always listens on 80).
#NOTECANVAS_PORT=6767


# === Canvas integrations ===

# GIPHY API key, for the GIFs and stickers tabs in the canvas stickers panel.
# Get one free at https://developers.giphy.com/. Read at container start rather
# than baked into the image, so changing it only needs a restart. Left unset,
# the panel still offers emoji and the GIPHY tabs stay hidden.
#
# Note this key reaches the browser: the panel calls api.giphy.com directly.
# Use a key scoped to this app, not one shared with anything sensitive.
#GIPHY_API_KEY=


# === Server ===

# Comma-separated CORS allowlist of frontend origins; also drives HTTPS detection.
# Set this to your public URL when running behind a reverse proxy.
#FRONTEND_URL=https://draw.example.com

# Express trust proxy setting: true, false, or a positive hop count.
# Keep false unless a trusted proxy in front of you sanitizes forwarded headers.
#TRUST_PROXY=false

# In-memory drawings list cache TTL in milliseconds.
#DRAWINGS_CACHE_TTL_MS=5000

# Days to retain drawing snapshots before the hourly sweep prunes them.
#SNAPSHOT_RETENTION_DAYS=2

# Max size (MB) of a single uploaded file accepted by multer (imports, database restores).
#UPLOAD_MAX_MB=100

# Max request body size (MB) for scene JSON/urlencoded payloads and the Socket.IO
# buffer. Images travel separately (see FILE_UPLOAD_MAX_MB), so this bounds scene JSON only.
#BODY_LIMIT_MB=50

# Max size (MB) of a single image accepted by PUT /api/drawings/:id/files/:fileId.
# The bundled nginx also caps request bodies at 50M, so raising this past 50 means
# raising client_max_body_size in frontend/nginx.conf.template to match.
#FILE_UPLOAD_MAX_MB=100


# === Database ===

# Prisma connection string. The compose files default this to the path
# below (the Prisma CLI needs it set during migrations and has no fallback of
# its own); uncomment here only to point somewhere else, e.g. Postgres, in which
# case set DATABASE_PROVIDER=postgresql too.
#DATABASE_URL=file:/app/prisma/dev.db

# Prisma datasource provider selected by the entrypoint: sqlite or postgresql.
#DATABASE_PROVIDER=sqlite

# Whether the entrypoint applies pending migrations on startup.
#RUN_MIGRATIONS=true

# Advisory-lock timeout (seconds) used by the migration entrypoint.
#MIGRATION_LOCK_TIMEOUT_SECONDS=120


# === Authentication ===

# local | hybrid | oidc_enforced | disabled
# "disabled" means no login at all -- every request runs as one shared local
# user. Never expose such an instance to an untrusted network.
#AUTH_MODE=local

# Secrets used to sign JWTs and CSRF tokens. Required in production; if left
# unset the entrypoint generates them once and persists them in the data volume,
# which is fine for a single instance but not portable across deployments.
#   generate with:  openssl rand -hex 32
#JWT_SECRET=
#CSRF_SECRET=

# Token lifetimes (vercel/ms style durations).
#JWT_ACCESS_EXPIRES_IN=15m
#JWT_REFRESH_EXPIRES_IN=7d

# Enable the password-reset flow.
#ENABLE_PASSWORD_RESET=false

# Rotate refresh tokens on each successful refresh.
#ENABLE_REFRESH_TOKEN_ROTATION=true

# Write authentication/authorization audit-log entries.
#ENABLE_AUDIT_LOGGING=false

# Disable the first-run onboarding gate in local-mode production.
#DISABLE_ONBOARDING_GATE=false

# Initial admin bootstrap setup code: lifetime (ms) and attempt limit.
#BOOTSTRAP_SETUP_CODE_TTL_MS=900000
#BOOTSTRAP_SETUP_CODE_MAX_ATTEMPTS=10

# Password policy.
#PASSWORD_MIN_LENGTH=12
#PASSWORD_MAX_LENGTH=100
#PASSWORD_REQUIRE_UPPERCASE=true
#PASSWORD_REQUIRE_LOWERCASE=true
#PASSWORD_REQUIRE_NUMBER=true
#PASSWORD_REQUIRE_SYMBOL=true


# === OIDC single sign-on ===
# Required when AUTH_MODE is hybrid or oidc_enforced.
# Redirect URI to register at your IdP: <your public URL>/api/auth/oidc/callback

#OIDC_ISSUER_URL=https://auth.example.com/application/o/excalidash/
#OIDC_CLIENT_ID=excalidash
#OIDC_REDIRECT_URI=https://draw.example.com/api/auth/oidc/callback

# Explicit discovery document URL, overriding the issuer-derived path. Useful
# when the browser-facing issuer differs from the one the container can reach.
#OIDC_DISCOVERY_URL=

# Client secret for confidential clients; omit for public (PKCE-only) clients.
#OIDC_CLIENT_SECRET=

# Display name of the provider shown in the UI.
#OIDC_PROVIDER_NAME=OIDC

# Space-separated scopes requested during login.
#OIDC_SCOPES=openid profile email

# ID-token claims the app reads. The user-ID claim is the stable key accounts
# are linked by; the display-name claim is re-synced into the profile on login.
#OIDC_USER_ID_CLAIM=sub
#OIDC_DISPLAY_NAME_CLAIM=name
#OIDC_EMAIL_CLAIM=email
#OIDC_EMAIL_VERIFIED_CLAIM=email_verified
#OIDC_GROUPS_CLAIM=groups

# Comma-separated groups whose members are granted admin.
#OIDC_ADMIN_GROUPS=excalidash-admins

# Reject logins whose email is not marked verified.
#OIDC_REQUIRE_EMAIL_VERIFIED=true

# Just-in-time provision users on first successful OIDC login.
#OIDC_JIT_PROVISIONING=true

# Grant admin to the first user provisioned via OIDC.
#OIDC_FIRST_USER_ADMIN=true

# Expected ID-token signing algorithm:
# RS256, RS384, RS512, PS256, PS384, PS512, ES256, ES384, ES512, EdDSA, HS256, HS384, HS512
#OIDC_ID_TOKEN_SIGNED_RESPONSE_ALG=RS256

# Client auth method at the token endpoint: none, client_secret_basic, client_secret_post
#OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic


# === Security ===

# Rate limiting: general API and CSRF-token issuance.
#RATE_LIMIT_MAX_REQUESTS=1000
#RATE_LIMIT_WINDOW_MS=900000
#CSRF_MAX_REQUESTS=60
#CSRF_RATE_LIMIT_WINDOW_MS=60000

# Redirect HTTP requests to HTTPS when a secure origin is detected.
#ENFORCE_HTTPS_REDIRECT=true

# Pepper mixed into API-key hashes. Set it BEFORE creating any keys -- changing
# it later invalidates every existing key.
#API_KEY_HASH_PEPPER=

# Verbose CSRF debug logging.
#DEBUG_CSRF=false


# === S3 storage ===
# Setting S3_BUCKET switches file storage from the uploads volume to S3.

#S3_BUCKET=excalidash
#S3_REGION=us-east-1

# Custom endpoint for S3-compatible services (MinIO, R2, ...).
#S3_ENDPOINT=https://s3.example.com

# Public base URL/CDN for objects; required for non-AWS endpoints.
#S3_PUBLIC_URL=https://s3.example.com/excalidash

# Force path-style addressing (required for MinIO).
#S3_FORCE_PATH_STYLE=false

# Object-key prefix for stored files; trailing slashes are stripped.
#S3_KEY_PREFIX=excalidash

# Omit both to use the ambient IAM credential chain.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=


# === Backups ===
# BACKUP_DIR must stay inside the excalidash-backups volume mount.

# Cron expression (5 or 6 fields); unset disables scheduled backups.
#BACKUP_SCHEDULE=0 0 4 * * *
#BACKUP_DIR=/app/backups
#BACKUP_RETENTION_DAYS=14


# === Update check ===

# Allow outbound requests to git.kazecik.com to check for new container image versions.
#UPDATE_CHECK_OUTBOUND=true


# === Link sharing ===

# Default lifetime (ms) of edit share links (7 days).
#LINK_SHARE_EDIT_DEFAULT_TTL_MS=604800000

# Default lifetime (ms) of view share links (30 days).
#LINK_SHARE_VIEW_DEFAULT_TTL_MS=2592000000

# Maximum allowed lifetime (ms) for any share link (90 days).
#LINK_SHARE_MAX_TTL_MS=7776000000


# ---------------------------------------------------------------------------
# Frontend variables are BUILD-TIME ONLY.
#
# They are baked into the JS bundle when the image is built, so setting them
# here does nothing to a prebuilt image. Pass them as --build-arg (the CI
# workflow in .forgejo/workflows/docker.yml does exactly that) and rebuild.
#
#   VITE_API_URL                     default /api. Leave it alone: any other
#                                    value makes the collaboration websocket
#                                    fall back to http://localhost:8000.
#   VITE_APP_VERSION                 version string shown in the UI;
#                                    defaults to the VERSION file.
#   VITE_APP_BUILD_LABEL             free-text build label shown in the UI.
#   VITE_EXCALIDASH_UI_FONT_FAMILY   app-shell display font; default Excalifont.
#   VITE_EXCALIDASH_UI_FONT_URL      self-hosted WOFF2 URL for that font.
# ---------------------------------------------------------------------------
